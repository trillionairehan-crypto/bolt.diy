# 코랄레드 환경 변수 — 실제 코드가 읽는 키만(2026-09-22 감사 기준). 복사해서 .env(로컬)로 쓴다.
# 프로덕션 값은 Cloudflare Pages 프로젝트 `coralred`의 환경 변수/시크릿에 있다(`wrangler pages secret list --project-name=coralred`).
# 서버 코드는 `env?.X || process.env.X`로 읽는다(Cloudflare env → 로컬 process.env 폴백).

# ── LLM (필수) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # 기본 모델 claude-sonnet-5, 검토 claude-haiku-4-5

# ── 플랫폼 Supabase (필수) — 계정·사용량·온보딩·UTM·배포 기록 ─
VITE_PLATFORM_SUPABASE_URL=        # https://<ref>.supabase.co
VITE_PLATFORM_SUPABASE_ANON_KEY=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용(탈퇴, 온보딩 insert, 쿼터 리셋)

# ── 코랄레드 Cloud Supabase — 생성 앱의 저장 백엔드(플랫폼과 별개 프로젝트) ─
CLOUD_SUPABASE_URL=
CLOUD_SUPABASE_SERVICE_KEY=
CLOUD_APP_TOKEN_SECRET=            # 앱 토큰 HMAC 비밀. 바꾸면 발급된 모든 앱 토큰이 무효.

# ── 미디어 생성 (이미지·영상) ─────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=      # Gemini 이미지(gemini-3.1-flash-image). GEMINI_API_KEY는 미사용.
R2_ACCESS_KEY_ID=                  # Cloudflare R2 (S3 호환)
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=                # https://pub-<hash>.r2.dev
VIDEO_PROVIDER=seedance            # seedance | kling
ARK_API_KEY=                       # Seedance(BytePlus ARK)
SEEDANCE_MODEL=
# KLING_API_KEY=  KLING_ACCESS_KEY=  KLING_SECRET_KEY=  KLING_API_BASE_URL=   (VIDEO_PROVIDER=kling일 때)
# IMAGE_PROVIDER=seedream  SEEDREAM_MODEL=                                     (Gemini 대신 Seedream)

# ── Cloudflare (생성 앱 배포·커스텀 도메인, R2 계정) ────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=              # Pages 프로젝트 생성/배포/도메인 권한

# ── 결제 (PortOne) ──────────────────────────────────────────
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=            # 웹훅 서명 검증(아직 미구현 — docs/API.md)

# ── 운영 ────────────────────────────────────────────────────
SENTRY_DSN=
VITE_KAKAO_JS_KEY=                 # 카카오 로그인/공유 JS 키

# ── 선택 ────────────────────────────────────────────────────
# VITE_DISABLE_PERSISTENCE=true    # 채팅 IndexedDB 저장 끄기(디버그)
# OPENAI_API_KEY=                  # SHOW_DEV_TOOLS=true로 다른 모델 실험할 때만
